{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0f355c6f0542dd04cc3fc370c67366a2",
  "name": "models-tscircuit-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*.glb", "/*.step", "/*.x_t"],
  },
  "kv_namespaces": [
    { "binding": "MODEL_CACHE", "id": "42ee43c1aaeb406fa2d3108c387ab11e" },
  ],
  "routes": [{ "pattern": "models.tscircuit.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000 },
}
