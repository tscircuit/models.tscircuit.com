{
  "name": "models.tscircuit.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:catalog": "bun scripts/generate-footprint-catalog.ts && bun scripts/generate-model-examples.ts",
    "dev": "bun run generate:catalog && vite --host 0.0.0.0",
    "build": "bun run generate:catalog && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/models.test.ts tests/footprints.test.ts tests/preview.test.ts tests/catalog.test.ts tests/examples.test.ts tests/parameters.test.ts tests/downloads.test.ts tests/library-updates.test.ts",
    "test:browser": "playwright test",
    "update:libraries": "bun scripts/update-model-libraries.ts"
  },
  "dependencies": {
    "@jscad/modeling": "^2.12.7",
    "@tscircuit/circuit-json-util": "^0.0.119",
    "@tscircuit/footprinter": "0.0.430",
    "@tscircuit/modelprinter": "0.0.8",
    "circuit-json-to-connectivity-map": "^0.0.33",
    "circuit-to-svg": "^0.0.393",
    "jscad-electronics": "0.0.186",
    "jscad-fiber": "^0.0.85",
    "lucide-react": "^0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "schematic-symbols": "^0.0.248",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4",
    "@tscircuit/math-utils": "0.0.36",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.5.0",
    "occt-import-js": "0.0.23",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
